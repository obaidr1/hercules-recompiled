-    const int idx[6] = {0, 1, 2, 2, 1, 3};
-    SDL_RenderGeometry(r, NULL, v, 4, idx, 6);
+    quad(x0 + nx, y0 + ny, x0 - nx, y0 - ny, x1 + nx, y1 + ny, x1 - nx, y1 - ny, c);
