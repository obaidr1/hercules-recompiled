 }
+/* On-screen touch controls (touch_pad.h) over the composed window frame:
+ * the pad's triangle list, alpha-blended, in window pixels. */
+static const char *TOUCH_VS =
+    "#version 330\n"
+    "layout(location=0) in vec2 a_pos;   /* window px, y down */\n"
+    "layout(location=1) in vec4 a_col;\n"
+    "uniform vec2 u_size;\n"
+    "out vec4 v_col;\n"
+    "void main() {\n"
+    "    v_col = a_col;\n"
+    "    gl_Position = vec4(a_pos.x / u_size.x * 2.0 - 1.0, 1.0 - a_pos.y / u_size.y * 2.0, 0.0, 1.0);\n"
+    "}\n";
+static const char *TOUCH_FS =
+    "#version 330\n"
+    "in vec4 v_col;\n"
+    "layout(location=0) out vec4 o_col;\n"
+    "void main() { o_col = v_col; }\n";
+static GLuint s_touch_prog = 0, s_touch_vao = 0, s_touch_vbo = 0;
+static GLint  s_touch_uSize = -1;
+static int    s_touch_failed = 0;
+static void touch_gl_release(void) {
+    s_touch_prog = 0; s_touch_vao = 0; s_touch_vbo = 0; s_touch_failed = 0;
+}
+static void gl_draw_touch_pad(int ww, int wh) {
+    const float *v = NULL;
+    const int n = touch_pad_triangles(ww, wh, &v);
+    if (n <= 0 || !v || s_touch_failed) return;
+    if (!s_touch_prog) {
+        s_touch_prog = build_program(TOUCH_VS, TOUCH_FS);
+        if (!s_touch_prog) { s_touch_failed = 1; return; }
+        s_touch_uSize = p_glGetUniformLocation(s_touch_prog, "u_size");
+        p_glGenVertexArrays(1, &s_touch_vao);
+        p_glGenBuffers(1, &s_touch_vbo);
+        p_glBindVertexArray(s_touch_vao);
+        p_glBindBuffer(PSXGL_ARRAY_BUFFER, s_touch_vbo);
+        p_glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 8 * sizeof(float), (void *)0);
+        p_glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 8 * sizeof(float), (void *)(2 * sizeof(float)));
+        p_glEnableVertexAttribArray(0);
+        p_glEnableVertexAttribArray(1);
+        p_glBindVertexArray(0);
+    }
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glEnable(GL_BLEND);
+    if (p_glBlendEquationSeparate)
+        p_glBlendEquationSeparate(PSXGL_FUNC_ADD, PSXGL_FUNC_ADD);
+    p_glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+    glViewport(0, 0, ww, wh);
+    p_glUseProgram(s_touch_prog);
+    p_glUniform2f(s_touch_uSize, (float)ww, (float)wh);
+    p_glBindVertexArray(s_touch_vao);
+    p_glBindBuffer(PSXGL_ARRAY_BUFFER, s_touch_vbo);
+    p_glBufferData(PSXGL_ARRAY_BUFFER, (GLsizeiptr)n * 8 * sizeof(float), v, PSXGL_STREAM_DRAW);
+    glDrawArrays(GL_TRIANGLES, 0, n);
+    p_glBindVertexArray(0);
+    p_glUseProgram(0);
+    glDisable(GL_BLEND);
+}
+
 static void gl_swap_now(int generated);
 static int  fg_keep_real(void);      /* frame generation */
 static void fg_note_swap(uint64_t ns);
@@ -9792,6 +9856,7 @@ static void gl_swap_with_osd(void) {
                 vy = wh - (int)((float)dh * slide + 0.5f);
