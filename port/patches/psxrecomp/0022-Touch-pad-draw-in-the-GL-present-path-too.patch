-static void fill_disc(SDL_Renderer* r, float cx, float cy, float rad, SDL_FColor c)
+/* Everything is built as one list of coloured triangles in output pixels
+ * (y down), so the SDL_Renderer path and the GL present path look the same. */
+enum { TP_MAX_VERTS = 16384 };
+static SDL_Vertex s_v[TP_MAX_VERTS];
+static int        s_nv;
+
+static void tri(float x0, float y0, float x1, float y1, float x2, float y2, SDL_FColor c)
+{
+    if (s_nv + 3 > TP_MAX_VERTS) return;
+    SDL_Vertex* v = &s_v[s_nv];
+    v[0] = (SDL_Vertex){{x0, y0}, c, {0, 0}};
+    v[1] = (SDL_Vertex){{x1, y1}, c, {0, 0}};
+    v[2] = (SDL_Vertex){{x2, y2}, c, {0, 0}};
+    s_nv += 3;
+}
+
+/* corners in order a, b, d, c (a strip: a-b on one side, c-d on the other) */
+static void quad(float ax, float ay, float bx, float by, float cx, float cy, float dx, float dy, SDL_FColor c)
+{
+    tri(ax, ay, bx, by, cx, cy, c);
+    tri(cx, cy, bx, by, dx, dy, c);
+}
+
+static void fill_disc(float cx, float cy, float rad, SDL_FColor c)
 {
     enum { N = 40 };
-    SDL_Vertex v[N + 1];
-    int idx[N * 3];
-    v[0].position = (SDL_FPoint){ cx, cy };
-    v[0].color = c;
     for (int i = 0; i < N; ++i) {
-        const float a = (float)i * 2.0f * (float)M_PI / N;
-        v[i + 1].position = (SDL_FPoint){ cx + rad * cosf(a), cy + rad * sinf(a) };
-        v[i + 1].color = c;
-        idx[i * 3] = 0; idx[i * 3 + 1] = i + 1; idx[i * 3 + 2] = (i + 1) % N + 1;
+        const float a0 = (float)i * 2.0f * (float)M_PI / N, a1 = (float)(i + 1) * 2.0f * (float)M_PI / N;
+        tri(cx, cy, cx + rad * cosf(a0), cy + rad * sinf(a0), cx + rad * cosf(a1), cy + rad * sinf(a1), c);
     }
-    SDL_RenderGeometry(r, NULL, v, N + 1, idx, N * 3);
 }
 
