From 7f2aa3c3da3720ae0064ad3428a0241e7151873f Mon Sep 17 00:00:00 2001
From: obaidr1 <147771377+obaidr1@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:54:26 +0100
Subject: [PATCH 22/26] Touch pad: draw in the GL present path too

The pad is now built as one triangle list (touch_pad_triangles); the
SDL_Renderer path draws it with one SDL_RenderGeometry, the GL path with
a small shader over the composed window frame, under the in-game menu.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/include/touch_pad.h   |   6 +
 runtime/src/gpu_gl_renderer.c |  65 +++++++++
 runtime/src/touch_pad.c       | 240 ++++++++++++++++++----------------
 3 files changed, 199 insertions(+), 112 deletions(-)

diff --git a/runtime/include/touch_pad.h b/runtime/include/touch_pad.h
index 7c67e6d..d498f11 100644
--- a/runtime/include/touch_pad.h
+++ b/runtime/include/touch_pad.h
@@ -22,6 +22,12 @@ int touch_pad_event(const union SDL_Event *ev);
 /* Draw over the composed frame (software / SDL_Renderer present path). */
 void touch_pad_draw_sdl(struct SDL_Renderer *renderer);
 
+/* The same picture for other present paths (GL): the vertex count of a
+ * triangle list for a w x h output, 0 when nothing is to be drawn. Each
+ * vertex is 8 floats: x, y in output pixels (y down), r, g, b, a, and two
+ * unused. Valid until the next call. */
+int touch_pad_triangles(int w, int h, const float **verts);
+
 /* Haptic tick through the app's activity (Android: a static
  * haptic(int) method, View.performHapticFeedback -- follows the system's
  * touch-feedback setting, needs no permission). No-op elsewhere. */
