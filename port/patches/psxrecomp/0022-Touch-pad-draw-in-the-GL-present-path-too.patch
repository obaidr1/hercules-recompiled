+        const float a0 = (float)i * 2.0f * (float)M_PI / N, a1 = (float)(i + 1) * 2.0f * (float)M_PI / N;
+        const float c0 = cosf(a0), s0 = sinf(a0), c1 = cosf(a1), s1 = sinf(a1);
+        quad(cx + rad * c0, cy + rad * s0, cx + ri * c0, cy + ri * s0,
+             cx + rad * c1, cy + rad * s1, cx + ri * c1, cy + ri * s1, c);
