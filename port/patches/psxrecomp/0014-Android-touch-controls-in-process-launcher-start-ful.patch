+#ifndef PSX_TOUCH_PAD_H
+#define PSX_TOUCH_PAD_H
+/*
+ * On-screen touch controls (Android): D-pad, the four face buttons, L1/L2/R1/R2,
+ * Select and Start, drawn half-transparent at the screen sides over the
+ * letterbox bars. They drive an SDL virtual gamepad, so the runtime sees an
+ * ordinary controller (Player 1 picks it like a physical pad). Hidden while a
+ * physical gamepad is connected.
+ *
+ * On by default on Android, off elsewhere; PSX_TOUCH_PAD=0/1 overrides.
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+union SDL_Event;
+struct SDL_Renderer;
+
+/* Feed every host event; returns 1 when it was a touch the pad consumed. */
+int touch_pad_event(const union SDL_Event *ev);
+
+/* Draw over the composed frame (software / SDL_Renderer present path). */
+void touch_pad_draw_sdl(struct SDL_Renderer *renderer);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PSX_TOUCH_PAD_H */
